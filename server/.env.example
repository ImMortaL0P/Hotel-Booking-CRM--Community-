# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shardacrm?retryWrites=true&w=majority

PORT=5000

# ---------------------------------------------------------------------------
# Email booking import (Email Import page). Reads OTA / website booking emails
# and turns them into bookings. Defaults to a built-in dummy inbox.
# To use a real mailbox set EMAIL_INBOX_PROVIDER=imap and the IMAP_* values.
# Gmail: enable IMAP, create an App Password, host imap.gmail.com.
# ---------------------------------------------------------------------------
EMAIL_INBOX_PROVIDER=dummy
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=bookings@yourhotel.com
# IMAP_PASSWORD=your-app-password
# IMAP_MAILBOX=INBOX
# EMAIL_LOOKBACK_DAYS=14
# EMAIL_MAX_MESSAGES=200
# Minutes between automatic syncs (0 = manual only). Default: 15 for imap, 0 for dummy.
# EMAIL_SYNC_INTERVAL_MINUTES=15
